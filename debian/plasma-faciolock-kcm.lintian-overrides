# The tag reads, in lintian's own words: "does not match any of the executables
# shipped in the package." It looks at this package's contents and at nothing
# else -- not at Depends. A KCM ships no executable on purpose; it is a plugin,
# and the programs that load it live in other packages by design.
#
# Both are declared rather than assumed: libkf6kcmutils-bin ships
# /usr/bin/kcmshell6 and systemsettings ships /usr/bin/systemsettings, read off
# `dpkg -S` rather than recalled, and both are in this package's Depends.
#
# Unlike the three source overrides, these two are a fix and are claimed as one.
# The dependency exists; lintian cannot see into another package to find it.
plasma-faciolock-kcm: desktop-command-not-in-package kcmshell6 [usr/share/applications/org.faciolock.panel.desktop]

# This entry is generated by kcmutils_add_qml_kcm from kcm_faciolock.json, not
# written here, and NoDisplay=true -- it exists so KRunner and System Settings
# can find the module, not to be launched from a menu.
plasma-faciolock-kcm: desktop-command-not-in-package systemsettings [usr/share/applications/kcm_faciolock.desktop]
