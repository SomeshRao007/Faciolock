# Rust build output.
target/

# Recorded IR captures and their sidecars. They contain faces and are never committed.
corpus/

# Development notes, kept outside the repository.
wiki/

# Models: fetched from upstream, not authored here. Provenance and licence status for
# each file is tracked in models/README.md, which is committed.
models/*.onnx
!models/README.md

# Editors, OS
.DS_Store
*.swp
*~
.idea/
.vscode/

# Enrolled templates are biometric data and never belong in a repository.
*.tpl
/var/

# Detection golden: box and landmark coordinates measured from real captures, so it is
# face-derived and stays local. Regenerate with tools/gen-goldens.py. The alignment
# golden beside it is a synthetic checkerboard and is committed.
crates/faciolock-vision/testdata/detect_golden.txt

# Credentials. A glob cannot match a key by its header, so prefer `git add <path>`
# over `git add -A`.
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pem
*.key
*_rsa
*_ed25519
.ssh/
yes
yes.pub

# Agent scratch
.claude/
.Codex/

# Python bytecode
__pycache__/
*.pyc

# Vendored crate tree, generated into a build copy by tools/mk-source-package.sh for
# offline builders.
/vendor/
/.cargo/config.toml

