# The socket exists at boot; the daemon does not.
#
# This is wiki/04's "zero RSS when idle" in three lines: systemd owns the listening inode,
# the first connect() starts faciolockd, and after `idle_timeout_secs` with nothing
# connecting the daemon exits and leaves this behind. Nothing is lost by the exit — the
# template store, the failure budget and the audit log are all on disk.
#
# `ListenSequentialPacket`, not `ListenStream`. wiki/04 specifies SOCK_SEQPACKET so message
# boundaries come from the kernel and faciolock-ipc has no framing to get wrong. Getting this
# line wrong hands the daemon a working SOCK_STREAM listener that mis-parses every request,
# so `serve::conforms` refuses to start on it rather than letting it be found at a lock
# screen.

[Unit]
Description=Faciolock face authentication socket
Documentation=file:///usr/share/doc/faciolock/04-architecture.md

[Socket]
ListenSequentialPacket=/run/faciolock.sock
SocketUser=root
# wiki/03 R2 / P6-d. This was root:root 0600 until Q10 measured the KDE greeter: it is not
# setuid, it links libpam itself, and it runs in the user's session — so a root-only socket
# means the lock screen can never show a face, only fall through to the password field.
#
# The group is what a human is added to, and it grants exactly one thing: the ability to ask
# `Auth` and `Status` **about yourself**. `serve::may_ask` enforces that from SO_PEERCRED, so
# the guarantee does not rest on this line being right — getting the mode wrong here widens
# who can ask about themselves, not what they can ask.
SocketGroup=faciolock-auth
SocketMode=0660
# One fd, handed whole to one long-lived process. Accept=yes would fork per connection,
# which is a camera per connection.
Accept=no
# FlushPending= is deliberately absent (P6-f). A daemon that cannot start never drains the
# connection that activated it, so systemd reactivates into the same failure until
# StartLimitBurst fails this unit. FlushPending=yes stops that — and also drops the honest
# connection that races an ordinary idle-exit, which today the next activation serves. The
# daemon drains its own queue on the startup-failure path instead, because it is the only
# party that can tell "I am broken" from "I went to sleep on schedule".

[Install]
WantedBy=sockets.target
